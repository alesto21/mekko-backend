VEGVESENET_API_KEY=your-key-here
ANTHROPIC_API_KEY=your-key-here
RAPIDAPI_KEY=your-key-here

# Optional. Empty = the feedback endpoint just logs to stdout, no Discord post.
DISCORD_WEBHOOK_URL=

# Optional. Empty = server-side RevenueCat entitlement verification is
# disabled (kill switch) and chat.py/scan.py fall back to trusting the
# client's is_pro field directly, exactly like before this was added.
# Use a *secret* v1 API key from RevenueCat (Project Settings -> API Keys),
# not the public SDK key already embedded in the Flutter app.
REVENUECAT_SECRET_KEY=
